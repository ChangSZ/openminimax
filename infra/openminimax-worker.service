# GPU-box VIDEO worker (serverless path) — runs on the g6e.12xlarge alongside the
# diffusers Turbo shim. Drains the shared DynamoDB task queue for kind=video ONLY,
# calls the private H3 shim (:30010, H3 on cuda:0), uploads the mp4 to the private
# result bucket, and writes the result back to DynamoDB (the poll Lambda serves it).
#
# Account-specific values (RESULT_BUCKET, table names, region) come from
# /etc/openminimax.env, which serving/bootstrap.sh generates at deploy time — so this
# unit carries NO placeholders and is committed as-is. Install (bootstrap.sh does this):
#   sudo cp infra/openminimax-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now openminimax-worker
[Unit]
Description=openminimax GPU video worker (DynamoDB queue -> H3 shim -> S3)
After=network-online.target openminimax-serve.service
Wants=network-online.target

[Service]
Type=simple
# root to match the serve/flux shims and read their root-owned /mnt/models outputs. The
# GPU-box DLAMI is Ubuntu (no ec2-user); AWS creds come from the instance profile, not a
# login user, so root is correct here.
User=root
WorkingDirectory=/opt/openminimax/gateway
# Deploy-time env (RESULT_BUCKET, KEYS_TABLE, TASKS_TABLE, AWS_REGION) — written by
# serving/bootstrap.sh from the serverless stack outputs. Kept out of the committed unit.
EnvironmentFile=/etc/openminimax.env
# Invariant, non-account-specific config (safe to commit):
Environment=WORKER_KIND=video
Environment=SGLANG_URL=http://127.0.0.1:30010
Environment=PRESIGN_TTL_S=3600
Environment=WORKER_POLL_SECONDS=2
# num_inference_steps sent to the shim. MUST match the Turbo LoRA the shim loaded:
# 8-step Turbo -> 9 (off-by-one). Do NOT set 50 (that's the deprecated base path).
Environment=SGLANG_STEPS=9
# app.* is importable only from the DLAMI venv where diffusers/boto3 live — NOT system python3.
ExecStart=/opt/pytorch/bin/python -m app.worker_main
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
