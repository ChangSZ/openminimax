# .env.example — environment variables this project reads.
#
# Nothing here is loaded automatically; it's a reference of every knob, grouped by
# WHERE it applies. Copy the lines you need into your shell (or a systemd unit's
# Environment=) — do NOT commit a filled-in .env (it's git-ignored).
#
# Almost everything has a sane default; the only values you MUST set per-deploy are
# your AWS region/account-derived resource names. Placeholders look like <this>.

# ============================================================================
# 1. Deploy-time (infra/deploy.sh, deploy_serverless.sh, deploy_gpu_global.sh)
# ============================================================================
AWS_REGION=us-west-2                     # your home region (control plane lives here)
STACK=openminimax                         # base CloudFormation stack name
# BASE_STACK=openminimax                   # base stack name, as seen by other scripts
# The result bucket is named <STACK>-results-<account-id> by the base template and is
# discovered from stack outputs — you do NOT hardcode it. Override only if needed:
# RESULT_BUCKET=<your-stack>-results-<your-account-id>

# ============================================================================
# 2. Control plane — Lambda handlers (gateway/lambdas/*) and admin CLI
#    (set as Lambda Environment by serverless.yaml; needed by app.admin_keys locally)
# ============================================================================
KEYS_TABLE=openminimax-serverless-keys    # DynamoDB keys table
TASKS_TABLE=openminimax-serverless-tasks  # DynamoDB tasks table (the queue)
# RESULT_BUCKET=<your-result-bucket>      # poll Lambda signs presigned GETs here
# PRESIGN_TTL_S=900                        # presigned URL TTL (seconds)
# IMAGE_WAIT_S=120                         # /v1/image_generation in-request poll budget
# GPU_INSTANCE_ID=i-xxxxxxxx               # autostop target (base stack output)
# IDLE_STOP_MINUTES=60                     # stop the GPU box after this idle window
# ADMIN_TOKEN=<random>                     # only for the FastAPI single-box admin path

# ============================================================================
# 3. GPU box — the worker (gateway/app/worker_main.py, drains the queue)
# ============================================================================
AWS_DEFAULT_REGION=us-west-2             # MUST match your home region (cross-region OK)
SGLANG_URL=http://127.0.0.1:30010        # the local serving shim (loopback only)
SGLANG_STEPS=9                           # 8-step Turbo off-by-one — KEEP THIS 9
# SGLANG_TIMEOUT_S=1800                    # per-clip ceiling (bump for long base runs)
# WORKER_KIND=video                        # video | image (which queue this worker drains)
# WORKER_POLL_SECONDS=2                     # queue poll interval

# ============================================================================
# 4. GPU box — the H3 serving shim (serving/h3_turbo_server.py, run_h3_server.sh)
# ============================================================================
# H3_MODEL=/mnt/models/MiniMax-H3-modular  # modular checkpoint dir (~196GB on EBS, root layout)
# H3_LORA=/mnt/models/lora/minimax_h3_fl2v_turbo_8step_v1.0_768p_bf16.safetensors
# H3_OUTDIR=/mnt/models/outputs            # where clips land (worker reads file_paths[0])
# H3_STEPS=8                               # denoise steps baked into the shim
# H3_PORT=30010
# HF_HUB_OFFLINE=1                         # weights are local; don't phone home

# --- OPTIONAL: image generation (FLUX.2 shim, serving/flux_image_server.py) ---------
# Only needed if you also serve text-to-image. black-forest-labs/FLUX.2-dev is a GATED HF
# repo: accept its license at https://huggingface.co/black-forest-labs/FLUX.2-dev and set
# HF_TOKEN (see section 5) — video H3 is ungated and needs no token. FLUX.2 runs RESIDENT
# on an idle card (cuda:2) in parallel with H3 video (cuda:0). Weights MUST live on the EBS
# volume so they survive stop/start — never /opt/dlami/nvme (instance-store, wiped on stop).
# FLUX_MODEL=/mnt/models/flux2-official    # OFFICIAL diffusers dir (transformer/ vae/ ...)
# FLUX_OUTDIR=/mnt/models/outputs          # where PNGs land (image worker reads locally)
# FLUX_STEPS=28                            # denoise steps (base; Turbo LoRA deferred)
# FLUX_QUANTIZE=1                          # fp8-quantize DiT at load to fit 48GB resident
# FLUX_PORT=30020
# CUDA_VISIBLE_DEVICES=2                   # pin FLUX to the idle card (set in the unit)

# ============================================================================
# 5. Model download (serving/download_model.sh)
# ============================================================================
# MODEL_ID=MiniMaxAI/MiniMax-H3
# MODEL_PATH=/mnt/models/MiniMax-H3        # target on the >=500GB gp3 volume
# DOWNLOAD_TURBO_LORA=1                     # also pull the lightx2v Turbo LoRA
# LORA_REPO=lightx2v/Minimax-h3-Turbo
# HF_TOKEN=hf_xxx                          # REQUIRED only for gated FLUX.2-dev (image); H3 is ungated
# DOWNLOAD_FLUX=1                          # pull FLUX.2-dev too (default: auto — on iff HF_TOKEN set)
# FLUX_ID=black-forest-labs/FLUX.2-dev     # gated repo; accept its license on HF first
